---
layout: compress
swcache: true
---
{% assign observer_issues = site.pages | where: 'observer_issue', true %}
{% assign kafka_issues = site.pages | where: 'kafka_issue', true %}
{% assign searchable = site.posts | concat: observer_issues | concat: kafka_issues %}
[
  {% for post in searchable %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "categories": {{ post.categories | join: ', ' | jsonify }},
    "tags": {{ post.tags | join: ', ' | jsonify }},
    "date": {{ post.date | jsonify }},
    {% capture content -%}{% include post-summary.html full_text=true %}{%- endcapture -%}
    "content": {{ content | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
